# =============================================================================
# Corporate AI Platform — variáveis de ambiente
#
#   cp .env.example .env        # ou: scripts/init-env.sh (gera os secrets)
#
# NUNCA versione o .env. Variáveis marcadas como [secret] são obrigatórias:
# a stack não sobe sem elas. Gere valores com:
#   openssl rand -hex 32        # 64 caracteres hex
#   openssl rand -hex 16        # 32 caracteres hex
# Use apenas caracteres hex nos secrets (vão dentro de URLs de conexão).
# =============================================================================

# --- Compose -----------------------------------------------------------------
# Arquivos do Compose. Modo CPU (padrão): docker-compose.yml
# Modo GPU da IA Local (requer nvidia-container-toolkit):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
COMPOSE_FILE=docker-compose.yml

# --- Portas publicadas no host -----------------------------------------------
LIBRECHAT_PORT=3080
LANGFUSE_PORT=3000
# LiteLLM é publicado apenas em 127.0.0.1 (testes de fumaça)
LITELLM_PORT=4000
# Portal de auditoria (Fase 9) — docs/audit.md
AUDIT_PORTAL_PORT=3090

# --- PostgreSQL (compartilhado: bancos langfuse e litellm) -------------------
POSTGRES_PASSWORD=            # [secret] superusuário postgres — openssl rand -hex 32
LANGFUSE_DB_PASSWORD=         # [secret] usuário langfuse     — openssl rand -hex 32
LITELLM_DB_PASSWORD=          # [secret] usuário litellm      — openssl rand -hex 32
AUDIT_DB_PASSWORD=            # [secret] usuário audit_portal (trilha de acesso dos auditores) — openssl rand -hex 32

# --- Portal de auditoria (Fase 9) — docs/audit.md ------------------------------
AUDIT_SESSION_SECRET=         # [secret] assinatura das sessões do portal de auditoria — openssl rand -hex 32

# --- Langfuse ----------------------------------------------------------------
LANGFUSE_NEXTAUTH_SECRET=     # [secret] openssl rand -hex 32
LANGFUSE_SALT=                # [secret] openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=      # [secret] EXATAMENTE 64 hex — openssl rand -hex 32
CLICKHOUSE_PASSWORD=          # [secret] openssl rand -hex 32
REDIS_AUTH=                   # [secret] openssl rand -hex 32
MINIO_ROOT_PASSWORD=          # [secret] openssl rand -hex 32

# Organização, projeto e usuário iniciais (criados na primeira subida)
LANGFUSE_INIT_ORG_ID=corporate-ai
LANGFUSE_INIT_ORG_NAME="Corporate AI"
LANGFUSE_INIT_PROJECT_ID=corporate-ai-platform
LANGFUSE_INIT_PROJECT_NAME="Corporate AI Platform"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY= # [secret] formato pk-lf-<hex> — "pk-lf-$(openssl rand -hex 16)"
LANGFUSE_INIT_PROJECT_SECRET_KEY= # [secret] formato sk-lf-<hex> — "sk-lf-$(openssl rand -hex 16)"
LANGFUSE_INIT_USER_EMAIL=admin@corporate-ai.local
LANGFUSE_INIT_USER_NAME=Administrador
LANGFUSE_INIT_USER_PASSWORD=  # [secret] openssl rand -hex 16

# --- LiteLLM (AI Gateway) ----------------------------------------------------
LITELLM_MASTER_KEY=           # [secret] formato sk-<hex> — "sk-$(openssl rand -hex 32)"
LITELLM_PORTAL_KEY=           # [secret] chave virtual do LibreChat — "sk-$(openssl rand -hex 32)"

# --- Classificador semântico (Fase 6) — docs/security.md ---------------------
# Confiança mínima para a IA Local liberar conteúdo como PUBLIC (abaixo → não sai).
SECURITY_CONFIDENCE_THRESHOLD=0.80

# --- Cotas, budgets e rate limit (Fase 4) — docs/quotas.md --------------------
# Ação ao exceder cota de tokens / budget em US$: LOCAL_FALLBACK (IA Local) ou BLOCK (HTTP 429).
TOKEN_QUOTA_ACTION=LOCAL_FALLBACK
BUDGET_ACTION=LOCAL_FALLBACK
# Fuso para os períodos diário/semanal/mensal das cotas.
QUOTA_TIMEZONE=America/Sao_Paulo
# Rate limit por usuário final (todos os modelos), aplicado nativamente pelo LiteLLM.
RATE_LIMIT_RPM=30
RATE_LIMIT_TPM=50000

# --- Provedores externos (somente o LiteLLM recebe estas chaves) -------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=             # fora do escopo das Fases 0–2
# ANTHROPIC_API_KEY=          # fora do escopo das Fases 0–2

# --- IA Local (Ollama) -------------------------------------------------------
LOCAL_AI_MODEL=qwen2.5:3b
# Janela de contexto (tokens). Limite para caber na VRAM em modo GPU (4 GB).
OLLAMA_CONTEXT_LENGTH=8192

# --- LibreChat ---------------------------------------------------------------
LIBRECHAT_CREDS_KEY=          # [secret] EXATAMENTE 64 hex — openssl rand -hex 32
LIBRECHAT_CREDS_IV=           # [secret] EXATAMENTE 32 hex — openssl rand -hex 16
LIBRECHAT_JWT_SECRET=         # [secret] openssl rand -hex 32
LIBRECHAT_JWT_REFRESH_SECRET= # [secret] openssl rand -hex 32
MEILI_MASTER_KEY=             # [secret] openssl rand -hex 32
